# ---------- Core ----------
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-prod

# ---------- API / Frontend ----------
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ---------- Postgres + pgvector ----------
POSTGRES_USER=apex
POSTGRES_PASSWORD=apex
POSTGRES_DB=apexmind
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
# Async URL used by the app (asyncpg); Alembic uses a sync variant internally.
DATABASE_URL=postgresql+asyncpg://apex:apex@postgres:5432/apexmind

# ---------- Redis (queue + E-STOP flag + pub/sub) ----------
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------- Model routing ----------
# Default model is a CONFIG choice only — switching it never touches code.
DEFAULT_PROVIDER=anthropic
ROUTING_CONFIG_PATH=app/router/routing.yaml

# ---------- Provider API keys (read from env; leave blank to disable) ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# OpenAI-compatible / local (vLLM, Ollama, LM Studio, etc.)
LOCAL_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_OPENAI_API_KEY=not-needed

# ---------- Safety ----------
ESTOP_KEY=apex:estop                 # Redis key for the global emergency stop
APPROVAL_TIMEOUT_SECONDS=300         # Level >=3 approval wait before auto-deny
MAX_TOOL_LEVEL=4                     # Level 5 is always refused; hard ceiling
AUDIT_LOG_IMMUTABLE=true             # append-only enforcement flag

# ---------- Orchestrator budgets ----------
MAX_STEPS=12
MAX_RUN_SECONDS=300
MAX_RUN_COST_USD=1.00

# ---------- Tool worker sandbox ----------
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEM_MB=256
SANDBOX_MAX_OUTPUT_BYTES=65536

# ---------- RAG ----------
EMBEDDING_TASK_TYPE=embeddings       # routed like any other task type
RAG_TOP_K=5
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
